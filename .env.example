# Copy to .env and fill in real values:  cp .env.example .env
#
# .env is gitignored; this file is committed so a fresh clone (e.g. on the lab
# machine) knows which variables Compose expects.
#
# All three POSTGRES_* vars are read ONLY on the very first initialisation of the
# data volume. Changing them later does nothing until the volume is removed with
# `docker compose down -v`.

# The role the server creates, and its password. Note this role is the SUPERUSER
# — POSTGRES_USER renames it, it does not create a restricted account. Giving the
# app a limited role needs an init script; see DOCKER-STUDY.md §4.6.
POSTGRES_USER=app
POSTGRES_PASSWORD=changeme

# A database of our own, so app data does not live in the server's `postgres`
# maintenance database.
POSTGRES_DB=issues

# What the app connects with. User, password and database must match the three
# values above — they are the same facts from two sides. Host `db` is the service
# name in docker-compose.yml, resolved by Compose's DNS.
DATABASE_URL=postgresql+psycopg2://app:changeme@db:5432/issues

# NVIDIA integrate.api key — local escalate/demo and the Modal secret named `nvidia`.
# NVIDIA_API_KEY=

# Modal CLI (optional; `modal token set` also writes ~/.modal.toml). Never commit real values.
# MODAL_TOKEN_ID=ak-...
# MODAL_TOKEN_SECRET=as-...

# Langfuse tracing for the demo (`rag/demo.py` → `langfuse_client`). Optional locally:
# without these keys the page behaves exactly as before (no traces). On Modal they live in
# the secret named `langfuse` (same three names). Project is US-region cloud (`D108`).
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
