# Copy to .env and fill in real values:  cp .env.example .env
#
# .env is gitignored; this file is committed so a fresh clone (e.g. on the lab
# machine) knows which variables Compose expects.

# Postgres sets the superuser password to this on FIRST initialisation only.
# Changing it later has no effect until the data volume is removed.
POSTGRES_PASSWORD=changeme

# What the app connects with. The password must match POSTGRES_PASSWORD above —
# they are the same fact from two sides.
# Host `db` is the service name in docker-compose.yml, resolved by Compose's DNS.
DATABASE_URL=postgresql+psycopg2://postgres:changeme@db:5432/postgres
